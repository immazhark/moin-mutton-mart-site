---
import {Search,ShoppingBasket,Beef,Drumstick,Plus,Minus,X,Trash2,MessageCircle,Phone,Copy} from 'lucide-react';
import {products,categories} from '../data/products';
import {MAX_LINE_NOTE,MAX_ORDER_NOTE,formatQuantity,type Product} from '../lib/order/order';
function unitHint(p:Product){
  if(p.unit==='g')return 'By weight · from '+formatQuantity(p,p.step);
  if(p.unit==='set')return p.setContents?'Per set · '+p.setContents:'Per set';
  return 'Per piece';
}
---
<section id="catalogue" tabindex="-1" class="catalogue" aria-labelledby="shop-title">
  <div class="shop-head">
    <h1 id="shop-title">Choose your cuts</h1>
    <p class="status" role="status" data-role="status">Checking current availability…</p>
  </div>
  <label class="search"><Search size={18} aria-hidden="true"/><span class="sr-only">Search the range</span><input data-role="search" type="search" dir="auto" placeholder="Search the range"/></label>
  <div class="categories" role="group" aria-label="Categories">
    {categories.map(category=><button type="button" data-category-filter={category} aria-pressed={category==='All'}>{category}</button>)}
  </div>
  <div class="product-grid" data-role="grid">
    {products.map(p=>{
      const Icon=p.category==='Chicken'?Drumstick:Beef;
      return <article class="product-card" data-category={p.category} data-product={p.id}>
        <div class="product-photo" role="img" aria-label={p.name+': photograph to come'}><Icon size={30} strokeWidth={1.5} aria-hidden="true"/><span>Photo to come</span></div>
        <div class="product-body">
          <h2>{p.name}</h2><p class="unit-hint">{unitHint(p)}</p><p class="rate" data-role="rate">Ask for today’s rate</p><p class="unit-hint" data-role="availability">Confirm with shop</p>
          <button type="button" class="add" data-action="increase" aria-label={'Add '+p.name}><Plus size={18} aria-hidden="true"/> Add</button>
          <div class="stepper" hidden>
            <button type="button" data-action="decrease" aria-label={'Reduce '+p.name}><Minus size={18} aria-hidden="true"/></button>
            <output aria-label={p.name+' quantity'} aria-live="polite"></output>
            <button type="button" data-action="increase" aria-label={'Increase '+p.name}><Plus size={18} aria-hidden="true"/></button>
          </div>
        </div>
      </article>;
    })}
  </div>
  <p class="no-results" data-role="no-results" hidden></p>
  <div class="basket-bar" data-role="basket" hidden>
    <ShoppingBasket size={22} aria-hidden="true"/><span role="status" aria-live="polite" data-role="count"></span><button type="button" data-action="open">Review request</button>
  </div>
  <dialog class="sheet" aria-labelledby="sheet-title">
    <div class="sheet-head"><h2 id="sheet-title">Your request</h2><button type="button" class="icon-btn" aria-label="Close" data-action="close"><X size={22} aria-hidden="true"/></button></div>
    <div class="empty" data-role="empty"><p>Nothing selected yet.</p><button type="button" class="btn-primary" data-action="close">Back to the counter</button></div>
    <div class="review-content" data-role="review" hidden>
      <ul class="lines" data-role="lines"></ul>
      <fieldset class="fulfil"><legend>Pickup or delivery</legend><div class="segmented">
        <button type="button" data-fulfil="pickup" aria-pressed="false">Pickup</button>
        <button type="button" data-fulfil="delivery" aria-pressed="false">Delivery</button>
        <button type="button" data-fulfil="discuss" aria-pressed="true">Not sure yet</button>
      </div></fieldset>
      <details class="note"><summary>Add a note (optional)</summary><label class="field"><span class="sr-only">Order note</span><textarea data-role="order-note" dir="auto" maxlength={MAX_ORDER_NOTE}></textarea></label></details>
      <p class="qualify">No payment here. Rates, availability and final weight are confirmed by the shop.</p>
      <p class="rate" data-role="estimate" hidden></p>
      <p class="qualify" role="status" data-role="review-notice" hidden></p>
      <a data-action="handoff" class="btn-primary whatsapp" target="_blank" rel="noopener noreferrer" hidden><MessageCircle size={20} aria-hidden="true"/> <span data-role="handoff-label"></span></a>
      <p data-role="long-link" tabindex="-1" class="qualify" role="alert" hidden>This request is too long for a WhatsApp link. Copy the unpriced request or call the shop.</p>
      <button data-action="check" type="button" class="btn-primary whatsapp" aria-disabled="false"><MessageCircle size={20} aria-hidden="true"/> <span data-role="check-label">Check latest rates &amp; availability</span></button>
      <p class="destination">Opens a chat with +91 81437 30054. You send the message yourself.</p>
      <div class="fallbacks"><button data-action="copy" type="button" class="btn-secondary"><Copy size={18} aria-hidden="true"/> <span data-role="copy-label">Copy request</span></button><a class="btn-secondary" href="tel:+918143730054"><Phone size={18} aria-hidden="true"/> Call instead</a></div>
      <p class="destination">Copy request always copies an unpriced enquiry, not an estimate.</p>
      <p role="status" aria-label="Clipboard status" class="copy-status"></p>
      <textarea class="copy-fallback" dir="auto" aria-label="Request text" readonly hidden></textarea>
    </div>
  </dialog>
  <template data-role="line-template">
    <li class="line">
      <div class="line-top"><h3></h3><button type="button" class="link-btn" data-action="remove"><Trash2 size={16} aria-hidden="true"/> Remove</button></div>
      <div class="stepper"><button type="button" data-action="decrease"><Minus size={18} aria-hidden="true"/></button><output aria-live="polite"></output><button type="button" data-action="increase"><Plus size={18} aria-hidden="true"/></button></div>
      <p class="unit-hint" data-role="line-rate" hidden></p><p class="qualify" role="alert" data-role="line-restriction" hidden></p>
      <div class="chips" role="group" data-role="cuts" hidden></div>
      <label class="field" data-role="cut-field"><span data-role="cut-label">Cut or preparation (optional)</span><input data-role="cut-input" dir="auto" maxlength={MAX_LINE_NOTE}/></label>
    </li>
  </template>
</section>
<script>
  import {mountCounter} from '../scripts/counter';
  const counter=document.querySelector<HTMLElement>('#catalogue');
  if(counter)mountCounter(counter);
</script>
