---
import BrandIcon from '../components/BrandIcon.astro';
import {Image} from 'astro:assets';
import logo from '../assets/logo.png';
import {ArrowLeft,Phone} from 'lucide-react';
import {shop,callUrl} from '../data/shop';
import '../styles/global.css';
---
<html lang="en-IN">
<head><BrandIcon />
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="robots" content="noindex,nofollow"/>
  <title>Page not found · {shop.name}</title>
</head>
<body>
  <header class="site-header"><a class="brand" href="/"><Image src={logo} width={40} densities={[1,2,3]} format="webp" quality={90} loading="eager" decoding="async" alt=""/><span class="brand-text"><strong>{shop.name}</strong><small>{shop.neighbourhood}, {shop.city}</small></span></a></header>
  <main class="simple-page missing-page">
    <p class="missing-label">404 · Page not found</p>
    <h1>This page is not on the counter</h1>
    <p>The link may have changed. Browse the range or call the shop for help.</p>
    <div class="missing-actions">
      <a class="btn-primary" href="/"><ArrowLeft size={18} aria-hidden="true"/> Back to the counter</a>
      <a class="btn-secondary" href={callUrl}><Phone size={18} aria-hidden="true"/> Call the shop</a>
    </div>
  </main>
</body>
</html>
