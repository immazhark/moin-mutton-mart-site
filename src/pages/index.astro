---
import { MapPin, Phone, MessageCircle } from 'lucide-react';
import Catalogue from '../components/Catalogue';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#202321" />
    <meta name="description" content="Browse Moin Mutton Mart’s range in Mallepally, Hyderabad, and prepare a WhatsApp request." />
    <title>Moin Mutton Mart · Mallepally</title>
  </head>
  <body>
    <a class="skip" href="#catalogue">Skip to the range</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Moin Mutton Mart home">
        <img src="/images/logo.png" width="40" height="50" alt="" />
        <span class="brand-text">
          <strong>Moin Mutton Mart</strong>
          <small><MapPin size={13} aria-hidden="true" /> Mallepally, Hyderabad</small>
        </span>
      </a>
      <a class="call" href="tel:+918143730054"><Phone size={18} aria-hidden="true" /> Call</a>
    </header>
    <main>
      <noscript>
        <link rel="stylesheet" href="/no-js.css" />
        <section class="no-script-contact" aria-labelledby="direct-contact"><h2 id="direct-contact">Contact the counter</h2><p>JavaScript is off. Browse the range below and ask the shop directly about cuts, rates and availability.</p><a class="btn-primary" href="https://wa.me/918143730054" rel="noreferrer"><MessageCircle size={20} aria-hidden="true"/> Ask on WhatsApp</a></section>
      </noscript>
      <Catalogue client:load />
      <section class="visit" aria-labelledby="visit-title">
        <h2 id="visit-title">Visit the shop</h2>
        <p>Mallepally, Hyderabad. Call to confirm directions, opening hours and collection.</p>
        <a class="btn-secondary" href="tel:+918143730054"><Phone size={18} aria-hidden="true" /> +91 81437 30054</a>
      </section>
    </main>
    <footer class="site-footer">
      <nav aria-label="Footer"><a href="/privacy/">Privacy</a><a href="/admin/">Manage shop</a></nav>
      <p>Preview build: photographs and quantity options await shop approval.</p>
    </footer>
  </body>
</html>
