---
import '../../styles/global.css';
import '../../styles/owner.css';
import OwnerConsole from '../../components/OwnerConsole';
import {Image} from 'astro:assets';
import logo from '../../assets/logo.png';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="robots" content="noindex,nofollow"/><title>Manage shop · Moin Mutton Mart</title></head><body><a class="skip" href="#owner-main">Skip to shop management</a><header class="site-header"><a class="brand" href="/"><Image src={logo} width={40} densities={[1,2,3]} format="webp" quality={90} loading="eager" decoding="async" alt=""/><span class="brand-text"><strong>Moin Mutton Mart</strong><small>Owner console</small></span></a></header><main id="owner-main" tabindex="-1" class="owner-page"><a class="owner-back" href="/">← Back to the counter</a><h1>Manage shop</h1><p class="owner-intro">Update your rates and availability in one place.</p><noscript><p>Shop management needs JavaScript to verify your authorised session. Enable it and reload this page.</p></noscript><OwnerConsole client:load/></main></body></html>
